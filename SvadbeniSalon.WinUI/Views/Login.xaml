<Window x:Class="SvadbeniSalon.WinUI.Views.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SvadbeniSalon.WinUI.Views"
             xmlns:validator="clr-namespace:SvadbeniSalon.WinUI.Validations"
             mc:Ignorable="d"
             x:Name="thisWindow"
             xmlns:viewModel="clr-namespace:SvadbeniSalon.WinUI.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Height="300"
             Width="500"
             MinHeight="300"
             MinWidth="500"
             Background="White">
    <Window.DataContext>
        <viewModel:LoginVM></viewModel:LoginVM>
    </Window.DataContext>
    <Window.Resources>
        <ControlTemplate x:Key="errorTemplate">
            <Border BorderBrush="OrangeRed"
                    BorderThickness="2">
                <Grid>
                    <AdornedElementPlaceholder></AdornedElementPlaceholder>
                    <TextBlock Text="{Binding [0].ErrorContent}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="OrangeRed"
                               Margin="0,0,4,0"></TextBlock>
                </Grid>
            </Border>
        </ControlTemplate>
    </Window.Resources>
    <Grid  VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Width="400"
                    MaxWidth="400"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Grid.Row="0">
            <TextBlock Margin="0,0,0,30"
                       FontSize="28">Login</TextBlock>
            <StackPanel>
                <TextBlock Text="Username"></TextBlock>
                <TextBox Validation.ErrorTemplate="{StaticResource errorTemplate}"
                         Margin="0,10,0,0"
                         x:Name="txtUsername">
                    <Binding Path="Username"
                             UpdateSourceTrigger="LostFocus">
                        <Binding.ValidationRules>
                            <validator:MinimumCharactersRule ValidatesOnTargetUpdated="False"
                                                             MinimumCharacters="1"></validator:MinimumCharactersRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
            </StackPanel>

            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Password"></TextBlock>
                <PasswordBox Validation.ErrorTemplate="{StaticResource errorTemplate}"
                             Margin="0,10,0,0"
                             Grid.Row="2"
                             x:Name="txtPassword">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PasswordChanged">
                            <i:InvokeCommandAction Command="{Binding PasswordChangedCommand}"
                                                   CommandParameter="{Binding ElementName=txtPassword}"></i:InvokeCommandAction>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </PasswordBox>
                <TextBlock Margin="0,10,0,0"
                           Foreground="OrangeRed"
                           Text="Incorrect username or password">
                    <TextBlock.Style>
                        <Style>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=LoginIncorrect, Mode=OneWay}"
                                             Value="false">
                                    <Setter Property="TextBlock.Visibility"
                                            Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Content="Login"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=thisWindow}"></Button>
        </StackPanel>

    </Grid>
</Window>
