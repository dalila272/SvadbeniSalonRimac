# Kopiraj u .env:  cp .env.example .env

# SQL Server
SQL_SA_PASSWORD=CHANGE_ME_strong_password
SQL_PORT=1435
SQL_DATABASE=1210386
# Lokalni dotnet run (Docker u compose-u gradi connection string prema sqlserver hostu)
ConnectionStrings__DefaultConnection=Server=localhost,1435;Database=1210386;User Id=sa;Password=CHANGE_ME_strong_password;TrustServerCertificate=True;

# API
API_PORT=5121

# JWT (najmanje 32 karaktera)
JWT_AUDIENCE=http://svadbeni-salon.local
JWT_ISSUER=http://svadbeni-salon.local
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_secret_key_32chars_min
JWT_DURATION_MINUTES=30

# CORS (browser / Swagger). Mobilne app ne koriste CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5121,http://127.0.0.1:5121

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# SMTP (Worker)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM=
SMTP_ADMIN_EMAIL=
